---
layout: layouts/base.njk
title: Hand Picked Jobs | Edurom Recruitment
description: Hand-picked job opportunities from the Edurom recruiting team, shared directly with candidates.
---

<section class="hero">
  <div class="hero-inner">
    <p class="hero-tagline">{{ site.tagline }}</p>
  </div>
  {% if collections.jobs | listed | selectattr("status", "equalto", "Open") | length %}
  <button class="share-float" id="shareDashboardBtn">
    <span class="share-float-label">Share these jobs</span>
    <span class="share-float-icon">↗</span>
  </button>
  {% endif %}
</section>

<div class="main">
  {% set openJobs = collections.jobs | listed | selectattr("status", "equalto", "Open") %}
  {% set stats = collections.jobs | listed | jobStats(site) %}
  {# "Roles posted" counts every role ever opened, including the ones hidden from the homepage. #}
  {% set allStats = collections.jobs | jobStats(site) %}
  {% set showStats = openJobs.length and stats.total and site.homepageStats and site.homepageStats.length %}
  {% set reviews = collections.reviews | activeReviews %}
  {% if openJobs.length %}
  <div class="jobs-heading-row">
    {# Heading for screen readers; the stats bar shows the count on screen. #}
    <h2 class="visually-hidden">Open positions</h2>
    <div class="filter-bar" id="filterBar">
      <button class="filter-btn active" data-filter="all">All</button>
      {% for job in openJobs %}
        {% for city in (job.data.city | cities) %}
          <button class="filter-btn" data-filter="{{ city | lower | replace(' ', '-') }}" data-label="{{ city }}">{{ city }}</button>
        {% endfor %}
        <button class="filter-btn" data-filter="{{ job.data.workingType | lower | replace(' ', '-') }}" data-label="{{ job.data.workingType }}">{{ job.data.workingType }}</button>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if showStats %}
  <div class="stats-bar" role="group" aria-label="Roles in numbers">
    {% if "roles" in site.homepageStats %}
    <span class="stats-bar-label"><span class="label-slashes" aria-hidden="true">//</span> roles in numbers</span>
    <span class="stats-bar-pill"><i></i>{{ stats.open }} open now</span>
    {% endif %}
    {% if "salary" in site.homepageStats and stats.current %}
    <span class="stats-bar-stat"><b>{{ stats.current.min | num }} – {{ stats.current.max | num }}</b> RON net / month</span>
    {% endif %}
    {% if "salary" in site.homepageStats and stats.b2b and stats.b2b.current %}
    <span class="stats-bar-stat"><b>{{ stats.b2b.current.min }} – {{ stats.b2b.current.max }}</b> EUR / hour B2B</span>
    {% endif %}
    {% if "working" in site.homepageStats %}
    <span class="stats-bar-working">
      {% for w in stats.working %}{% if w.open %}
      <span class="stats-bar-stat"><b>{{ w.open }}</b> {{ w.label | lower }}</span>
      {% endif %}{% endfor %}
    </span>
    {% endif %}
    {% if "roles" in site.homepageStats %}
    <span class="stats-bar-meta">{{ allStats.total }} roles posted since {{ allStats.since }}</span>
    {% endif %}
  </div>
  {% endif %}

  <div class="jobs-layout{% if reviews.length %} jobs-layout--side{% endif %}">
  {% if openJobs.length %}
  <section class="jobs-section">
    <div class="job-list{% if openJobs.length == 1 %} job-list--single{% endif %}" id="jobList">
      {% for job in openJobs | reverse %}
      {% set filterTags = [] %}
      {% for city in (job.data.city | cities) %}{% set filterTags = filterTags.concat([city | lower | replace(' ', '-')]) %}{% endfor %}
      {% set filterTags = filterTags.concat([job.data.workingType | lower | replace(' ', '-')]) %}
      {% if job.data.techStack %}{% for tech in job.data.techStack %}{% set filterTags = filterTags.concat([tech | lower | replace(' ', '-')]) %}{% endfor %}{% endif %}
      <a class="job-card" href="{{ job.url }}" data-tags="{{ filterTags | join(' ') }}">
        <div class="job-card-header">
          <span class="job-card-title">{{ job.data.title }}</span>
          {% if job.data.seniority and job.data.seniority.length %}
          <div class="job-card-seniority-row"><span class="job-card-seniority">{{ job.data.seniority | join(" / ") }}</span></div>
          {% endif %}
          <div class="job-card-meta-right">
            <span class="job-card-new">New</span>
          </div>
        </div>
        {% set client = collections.clients | findBySlug(job.data.client) %}
        {% if client %}
        <p class="job-card-teaser">{{ client.data.teaser }}</p>
        {% endif %}
        <div class="job-card-footer">
          <div class="job-card-tags">
            {% for city in (job.data.city | cities) %}
            <span class="job-card-tag job-card-tag--meta">{{ city }}</span>
            {% endfor %}
            <span class="job-card-tag job-card-tag--meta">{{ job.data.workingType }}</span>
            {% if job.data.techStack %}
              {% for tech in job.data.techStack %}
                {% if loop.index <= 3 %}
                <span class="job-card-tag job-card-tag--blue-2">{{ tech }}</span>
                {% endif %}
              {% endfor %}
            {% endif %}
          </div>
          <span class="job-card-salary">{{ job.data.salaryMin | salaryRange(job.data.salaryMax, job.data.salaryCurrency) }}</span>
        </div>
        {% set recruiter = collections.team | findBySlug(job.data.recruiter) %}
        {% if recruiter %}
        {% set zoom = recruiter.data.photoZoom | default(100, true) %}
        {% set posX = recruiter.data.photoPositionX | default(50, true) %}
        {% set posY = recruiter.data.photoPositionY | default(50, true) %}
        <div class="job-card-recruiter">
          <div class="job-card-recruiter-left">
            <div class="job-card-recruiter-avatar">
              <img src="{{ recruiter.data.photo }}" alt="" style="width: {{ zoom }}%; height: {{ zoom }}%; margin-left: {{ -1 * (zoom - 100) * (posX / 100) }}%; margin-top: {{ -1 * (zoom - 100) * (posY / 100) }}%;" />
            </div>
            <div class="job-card-recruiter-info">
              <span class="job-card-recruiter-name">{{ recruiter.data.name }}</span>
              {% if recruiter.data.role %}<span class="job-card-recruiter-role">{{ recruiter.data.role }}</span>{% endif %}
            </div>
          </div>
          <span class="job-card-view-role">View role <span aria-hidden="true">→</span></span>
        </div>
        {% endif %}
      </a>
      {% endfor %}
    </div>
  </section>
  {% else %}
  <div class="empty-state">
    <p class="empty-state-title">No open roles right now.</p>
    <p class="empty-state-text">Stay connected — we share new opportunities regularly.</p>
    <a class="btn btn-primary" href="{{ site.linkedin }}" target="_blank" rel="noopener">Follow our team on LinkedIn →</a>
  </div>
  {% endif %}

  {% if reviews.length %}
  <aside class="reviews-card" aria-label="Working with our team">
    <div class="reviews-card-head">
      <span class="reviews-card-label"><span class="label-slashes" aria-hidden="true">//</span> working with our team</span>
      {% if reviews.length > 1 %}
      <span class="review-wheel-controls">
        <button type="button" class="review-wheel-btn" id="reviewPrev" aria-label="Previous review"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 10l4-4 4 4"/></svg></button>
        <button type="button" class="review-wheel-btn" id="reviewNext" aria-label="Next review"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4"/></svg></button>
      </span>
      {% endif %}
    </div>
    <div class="reviews-card-list" id="reviewWheel">
      {% for review in reviews %}
      <figure class="review review--{{ review.data.type }}"{% if loop.index0 >= 4 %} hidden{% endif %}>
        <blockquote class="review-quote">“{{ review.data.quote }}”</blockquote>
        <figcaption class="review-person">
          {% if review.data.photo %}<img class="review-photo" src="{{ review.data.photo }}" alt="" width="28" height="28" loading="lazy" />{% endif %}
          <span class="review-info">
            <span class="review-name">{{ review.data.name }}</span>
            <span class="review-type">
              {{ "Hiring partner" if review.data.type == "hiring_partner" else "Candidate" }}
              {% if review.data.linkedin %}<span aria-hidden="true">·</span> <a class="review-link" href="{{ review.data.linkedin }}" target="_blank" rel="noopener" aria-label="Read {{ review.data.name }}'s review on LinkedIn">LinkedIn ↗</a>{% endif %}
            </span>
          </span>
        </figcaption>
      </figure>
      {% endfor %}
    </div>
    {% if reviews.length > 1 %}
    <span class="review-swipe-dots" aria-hidden="true">{% for review in reviews %}<i{% if loop.first %} class="on"{% endif %}></i>{% endfor %}</span>
    {% endif %}
  </aside>
  {% endif %}
  </div>

  <section class="more-jobs-cta">
    <p class="more-jobs-cta-text">Looking for more options? Browse every open IT role at Edurom.</p>
    <a class="more-jobs-cta-btn" href="https://www.edurom.ro/it-jobs/" target="_blank" rel="noopener">See all IT jobs →</a>
  </section>
</div>

<script>
  // On desktop the reviews card follows the scroll, so it must fit the window. When all
  // reviews fit, they simply show. When they don't, the card shows as many as fit (at most
  // 4) on a strip that glides up like a wheel every few seconds, with the top of the next
  // review peeking in at the bottom and arrows to turn it by hand. Hovering the card or
  // keyboard focus inside it pauses it. Below the sidebar breakpoint the reviews are a
  // swipeable row and none of this applies.
  (function() {
    var wheel = document.getElementById('reviewWheel');
    if (!wheel) return;
    var card = wheel.closest('.reviews-card');
    var desktop = window.matchMedia('(min-width: 1141px)');
    var MAX = 4, EVERY = 6000, ANIM = 700, PEEK = 44, STICKY_TOP = 168, BOTTOM_GAP = 24;
    var reviews = Array.prototype.slice.call(wheel.querySelectorAll('.review'));
    var total = reviews.length, top = 0, busy = false, paused = false, turning = false, timer;

    // Move the reviews onto a strip, followed by copies of the first few so it can wrap round.
    var strip = document.createElement('div');
    strip.className = 'review-strip';
    reviews.forEach(function(r) { r.hidden = false; strip.appendChild(r); });
    for (var i = 0; i <= MAX; i++) {
      var copy = reviews[i % total].cloneNode(true);
      copy.classList.add('review--copy');
      copy.setAttribute('aria-hidden', 'true');
      copy.inert = true;
      strip.appendChild(copy);
    }
    wheel.appendChild(strip);
    wheel.classList.add('is-wheel');
    card.classList.add('has-wheel');
    var items = strip.children;

    function place(animate) {
      if (!desktop.matches) {
        card.classList.remove('can-turn');
        turning = false;
        strip.style.transform = wheel.style.height = '';
        reviews.forEach(function(r) { r.inert = false; });
        return;
      }
      wheel.classList.toggle('is-still', !animate);
      var room = window.innerHeight - STICKY_TOP - BOTTOM_GAP - (card.offsetHeight - wheel.offsetHeight);
      var all = items[total].offsetTop - 14;
      turning = total > 1 && all > room;
      card.classList.toggle('can-turn', turning);
      if (!turning) {
        top = 0;
        strip.style.transform = '';
        wheel.style.height = all + 'px';
        reviews.forEach(function(r) { r.inert = false; });
        return;
      }
      var y = items[top].offsetTop;
      var shown = Math.min(MAX, total - 1);
      while (shown > 1 && items[top + shown].offsetTop - y + PEEK > room) shown--;
      strip.style.transform = 'translateY(' + -y + 'px)';
      wheel.style.height = (items[top + shown].offsetTop - y + PEEK) + 'px';
      // Only the reviews in view are reachable by keyboard and screen readers.
      reviews.forEach(function(r, i) { r.inert = (i - top + total) % total >= shown; });
      if (!animate) wheel.offsetHeight;
    }

    // step 1 = forward (strip moves up), -1 = back.
    function turn(step) {
      if (busy || !turning || !desktop.matches) return;
      busy = true;
      if (step < 0 && top === 0) { top = total; place(false); }
      top += step;
      place(true);
      setTimeout(function() {
        if (top === total) { top = 0; place(false); }
        busy = false;
      }, ANIM);
    }

    // Keyboard focus pauses it too; focus left behind by a mouse click on an arrow does not.
    function keyboardFocusInside() { var a = document.activeElement; return card.contains(a) && a.matches(':focus-visible'); }
    card.addEventListener('mouseenter', function() { paused = true; });
    card.addEventListener('mouseleave', function() { paused = keyboardFocusInside(); });
    card.addEventListener('focusin', function(e) { if (e.target.matches(':focus-visible')) paused = true; });
    card.addEventListener('focusout', function(e) { paused = card.matches(':hover') || (card.contains(e.relatedTarget) && e.relatedTarget.matches(':focus-visible')); });

    function restart() {
      clearInterval(timer);
      timer = setInterval(function() { if (!paused && !document.hidden) turn(1); }, EVERY);
    }
    var next = document.getElementById('reviewNext'), prev = document.getElementById('reviewPrev');
    if (next) next.addEventListener('click', function() { turn(1); restart(); });
    if (prev) prev.addEventListener('click', function() { turn(-1); restart(); });
    window.addEventListener('resize', function() { place(false); });
    place(false);
    if (document.fonts) document.fonts.ready.then(function() { place(false); });
    restart();
  })();

  // On phones and tablets the reviews are a swipeable row; the dots below it follow the swipe.
  (function() {
    var dots = document.querySelectorAll('.review-swipe-dots i');
    if (!dots.length) return;
    var list = document.querySelector('.reviews-card-list');
    var reviews = list.querySelectorAll('.review:not(.review--copy)');
    function update() {
      var left = list.getBoundingClientRect().left, current = 0, best = Infinity;
      if (list.scrollLeft + list.clientWidth >= list.scrollWidth - 2) current = reviews.length - 1;
      else reviews.forEach(function(r, i) {
        var d = Math.abs(r.getBoundingClientRect().left - left);
        if (d < best) { best = d; current = i; }
      });
      dots.forEach(function(d, i) { d.classList.toggle('on', i === current); });
    }
    list.addEventListener('scroll', update, { passive: true });
  })();

  (function() {
    var bar = document.getElementById('filterBar');
    if (!bar) return;

    // deduplicate filter buttons
    var seen = {};
    bar.querySelectorAll('.filter-btn[data-filter]').forEach(function(btn) {
      var key = btn.dataset.filter;
      if (key === 'all') return;
      if (seen[key]) { btn.remove(); }
      else { seen[key] = true; }
    });

    bar.addEventListener('click', function(e) {
      var btn = e.target.closest('.filter-btn');
      if (!btn) return;
      bar.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var filter = btn.dataset.filter;
      document.querySelectorAll('.job-card').forEach(function(card) {
        if (filter === 'all') { card.style.display = ''; return; }
        var tags = (card.dataset.tags || '').split(' ');
        card.style.display = tags.includes(filter) ? '' : 'none';
      });
    });

    var shareBtn = document.getElementById('shareDashboardBtn');
    if (shareBtn) {
      shareBtn.addEventListener('click', function() {
        if (navigator.share) {
          navigator.share({ title: document.title, url: window.location.href });
        } else {
          navigator.clipboard.writeText(window.location.href).then(function() {
            var label = shareBtn.querySelector('.share-float-label');
            var icon = shareBtn.querySelector('.share-float-icon');
            label.textContent = 'Link copied';
            icon.textContent = '✓';
            setTimeout(function() {
              label.textContent = 'Share these jobs';
              icon.textContent = '↗';
            }, 2000);
          });
        }
      });
    }
  })();
</script>
