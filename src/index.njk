---
layout: layouts/base.njk
title: Hand Picked Jobs | Edurom Recruitment
description: Hand-picked job opportunities from the Edurom recruiting team, shared directly with candidates.
---

<section class="hero">
  <div class="hero-inner">
    <p class="hero-tagline">{{ site.tagline }}</p>
  </div>
  {% if collections.jobs | selectattr("status", "equalto", "Open") | length %}
  <button class="share-float" id="shareDashboardBtn">
    <span class="share-float-label">Share these jobs</span>
    <span class="share-float-icon">↗</span>
  </button>
  {% endif %}
</section>

<div class="main">
  {% set openJobs = collections.jobs | selectattr("status", "equalto", "Open") %}
  {% set stats = collections.jobs | jobStats %}
  {% set showStats = stats.total and site.homepageStats and site.homepageStats.length %}
  <div class="jobs-layout{% if showStats %} jobs-layout--stats{% endif %}">
  {% if openJobs.length %}
  <section class="jobs-section">
    <div class="jobs-heading-row">
      <h2 class="jobs-heading">Open Positions <span class="jobs-count">({{ openJobs | length }})</span></h2>
      <div class="filter-bar" id="filterBar">
        <button class="filter-btn active" data-filter="all">All</button>
        {% for job in openJobs %}
          {% for city in job.data.city.split(", ") %}
            <button class="filter-btn" data-filter="{{ city | lower | replace(' ', '-') }}" data-label="{{ city }}">{{ city }}</button>
          {% endfor %}
          <button class="filter-btn" data-filter="{{ job.data.workingType | lower | replace(' ', '-') }}" data-label="{{ job.data.workingType }}">{{ job.data.workingType }}</button>
          {% endfor %}
      </div>
    </div>
    <div class="job-list{% if openJobs.length == 1 %} job-list--single{% endif %}" id="jobList">
      {% for job in openJobs | reverse %}
      {% set filterTags = [] %}
      {% for city in job.data.city.split(", ") %}{% set filterTags = filterTags.concat([city | lower | replace(' ', '-')]) %}{% endfor %}
      {% set filterTags = filterTags.concat([job.data.workingType | lower | replace(' ', '-')]) %}
      {% if job.data.techStack %}{% for tech in job.data.techStack %}{% set filterTags = filterTags.concat([tech | lower | replace(' ', '-')]) %}{% endfor %}{% endif %}
      <a class="job-card" href="{{ job.url }}" data-tags="{{ filterTags | join(' ') }}">
        <div class="job-card-header">
          <span class="job-card-title">{{ job.data.title }}</span>
          {% if job.data.seniority and job.data.seniority.length %}
          <div class="job-card-seniority-row"><span class="job-card-seniority">{{ job.data.seniority | join(" / ") }}</span></div>
          {% endif %}
          <div class="job-card-meta-right">
            <span class="job-card-new">New</span>
          </div>
        </div>
        {% if job.data.clientTeaser %}
        <p class="job-card-teaser">{{ job.data.clientTeaser }}</p>
        {% endif %}
        <div class="job-card-footer">
          <div class="job-card-tags">
            {% for city in job.data.city.split(", ") %}
            <span class="job-card-tag job-card-tag--meta">{{ city }}</span>
            {% endfor %}
            <span class="job-card-tag job-card-tag--meta">{{ job.data.workingType }}</span>
            {% if job.data.techStack %}
              {% for tech in job.data.techStack %}
                {% if loop.index <= 3 %}
                <span class="job-card-tag job-card-tag--blue-2">{{ tech }}</span>
                {% endif %}
              {% endfor %}
            {% endif %}
          </div>
          <span class="job-card-salary">{{ job.data.salaryMin | salaryRange(job.data.salaryMax, job.data.salaryCurrency) }}</span>
        </div>
        {% set recruiter = collections.team | findBySlug(job.data.recruiter) %}
        {% if recruiter %}
        {% set zoom = recruiter.data.photoZoom | default(100, true) %}
        {% set posX = recruiter.data.photoPositionX | default(50, true) %}
        {% set posY = recruiter.data.photoPositionY | default(50, true) %}
        <div class="job-card-recruiter">
          <div class="job-card-recruiter-left">
            <div class="job-card-recruiter-avatar">
              <img src="{{ recruiter.data.photo }}" alt="" style="width: {{ zoom }}%; height: {{ zoom }}%; margin-left: {{ -1 * (zoom - 100) * (posX / 100) }}%; margin-top: {{ -1 * (zoom - 100) * (posY / 100) }}%;" />
            </div>
            <div class="job-card-recruiter-info">
              <span class="job-card-recruiter-name">{{ recruiter.data.name }}</span>
              {% if recruiter.data.role %}<span class="job-card-recruiter-role">{{ recruiter.data.role }}</span>{% endif %}
            </div>
          </div>
          <span class="job-card-view-role">View role <span aria-hidden="true">→</span></span>
        </div>
        {% endif %}
      </a>
      {% endfor %}
    </div>
  </section>
  {% else %}
  <div class="empty-state">
    <p class="empty-state-title">No open roles right now.</p>
    <p class="empty-state-text">Stay connected — we share new opportunities regularly.</p>
    <a class="btn btn-primary" href="{{ site.linkedin }}" target="_blank" rel="noopener">Follow our team on LinkedIn →</a>
  </div>
  {% endif %}

  {% if showStats %}
  {% set visits = traffic | trafficStats %}
  <aside class="stats-card" aria-label="Roles in numbers">
    {% if "roles" in site.homepageStats %}
    <div class="stats-card-section stats-card-section--tight">
      <span class="stats-card-label">// roles in numbers</span>
      <div class="stats-card-hero-row">
        <span class="stats-card-hero">{{ stats.total }}</span>
        <span class="stats-card-hero-label">roles posted</span>
      </div>
      <div class="stats-card-row stats-card-row--center stats-card-open-row">
        <span class="stats-card-pill"><i></i>{{ stats.open }} open now</span>
        <span class="stats-card-meta">since {{ stats.since }}</span>
      </div>
    </div>
    {% endif %}
    {% if "salary" in site.homepageStats %}
    <div class="stats-card-section">
      <div class="stats-card-row">
        <span class="stats-card-label">Net salary</span>
        <span class="stats-card-meta">RON / month</span>
      </div>
      <div class="stats-card-big">{{ stats.salaryMin | num }} – {{ stats.salaryMax | num }}</div>
      <div class="stats-card-track" role="img" aria-label="Salary range {{ stats.salaryMin | num }} to {{ stats.salaryMax | num }} RON, midpoint {{ stats.medianMid | num }}">
        <div class="stats-card-fill" style="left: {{ stats.salaryBar.left }}%; width: {{ stats.salaryBar.width }}%"></div>
        <div class="stats-card-mark" style="left: {{ stats.salaryBar.mid }}%"></div>
      </div>
      <div class="stats-card-help">Typical midpoint <strong>{{ stats.medianMid | num }}</strong></div>
    </div>
    {% endif %}
    {% if "working" in site.homepageStats %}
    <div class="stats-card-section">
      <span class="stats-card-label">Working model</span>
      <div class="stats-card-split" role="img" aria-label="{% set sep = joiner(", ") %}{% for w in stats.working %}{% if w.count %}{{ sep() }}{{ w.count }} {{ w.label | lower }}{% endif %}{% endfor %}">
        {% for w in stats.working %}{% if w.count %}<div style="flex: {{ w.count }} 1 0"></div>{% endif %}{% endfor %}
      </div>
      <div class="stats-card-row stats-card-legend">
        {% for w in stats.working %}{% if w.count %}<span><b>{{ w.count }}</b> <em>{{ w.label | lower }}</em></span>{% endif %}{% endfor %}
      </div>
    </div>
    {% endif %}
    {% if "ai" in site.homepageStats %}
    <div class="stats-card-section">
      <span class="stats-card-label">AI &amp; ML</span>
      <div class="stats-card-row stats-card-row--center stats-card-row--wide">
        <div class="stats-card-count"><span class="stats-card-big">{{ stats.aiCount }}</span><span>of {{ stats.total }} roles</span></div>
        <div class="stats-card-dots" aria-hidden="true">{% for i in range(0, stats.total) %}<span{% if i < stats.aiCount %} class="on"{% endif %}></span>{% endfor %}</div>
      </div>
      <div class="stats-card-help">work hands-on with LLMs or ML</div>
    </div>
    {% endif %}
    {% if "traffic" in site.homepageStats and visits.ready and visits.allTime.visitors %}
    <div class="stats-card-section">
      <span class="stats-card-label">Visitors</span>
      <div class="stats-card-count"><span class="stats-card-big">{{ visits.allTime.visitors | num }}</span><span>so far</span></div>
      <div class="stats-card-help"><strong>{{ visits.month.visitors | num }}</strong> this month</div>
    </div>
    {% endif %}
    {% if "seniority" in site.homepageStats %}
    <div class="stats-card-section">
      <span class="stats-card-label">Average salary by seniority</span>
      <div class="stats-card-rows">
        {% for g in stats.seniority %}{% if g.avgMin %}
        <div class="stats-card-row"><span>{{ g.label }}</span><b>{{ g.avgMin | num }} – {{ g.avgMax | num }}</b></div>
        {% endif %}{% endfor %}
      </div>
    </div>
    {% endif %}
    {% if "roleType" in site.homepageStats %}
    <div class="stats-card-section">
      <span class="stats-card-label">Average salary by role type</span>
      <div class="stats-card-rows">
        {% for g in stats.roleTypes %}{% if g.avgMin and g.count > 1 %}
        <div class="stats-card-row"><span>{{ g.label }}</span><b>{{ g.avgMin | num }} – {{ g.avgMax | num }}</b></div>
        {% endif %}{% endfor %}
      </div>
    </div>
    {% endif %}
  </aside>
  {% endif %}
  </div>

  <section class="more-jobs-cta">
    <p class="more-jobs-cta-text">Looking for more options? Browse every open IT role at Edurom.</p>
    <a class="more-jobs-cta-btn" href="https://www.edurom.ro/it-jobs/" target="_blank" rel="noopener">See all IT jobs →</a>
  </section>
</div>

<script>
  (function() {
    var bar = document.getElementById('filterBar');
    if (!bar) return;

    // deduplicate filter buttons
    var seen = {};
    bar.querySelectorAll('.filter-btn[data-filter]').forEach(function(btn) {
      var key = btn.dataset.filter;
      if (key === 'all') return;
      if (seen[key]) { btn.remove(); }
      else { seen[key] = true; }
    });

    bar.addEventListener('click', function(e) {
      var btn = e.target.closest('.filter-btn');
      if (!btn) return;
      bar.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var filter = btn.dataset.filter;
      document.querySelectorAll('.job-card').forEach(function(card) {
        if (filter === 'all') { card.style.display = ''; return; }
        var tags = (card.dataset.tags || '').split(' ');
        card.style.display = tags.includes(filter) ? '' : 'none';
      });
    });

    var shareBtn = document.getElementById('shareDashboardBtn');
    if (shareBtn) {
      shareBtn.addEventListener('click', function() {
        if (navigator.share) {
          navigator.share({ title: document.title, url: window.location.href });
        } else {
          navigator.clipboard.writeText(window.location.href).then(function() {
            var label = shareBtn.querySelector('.share-float-label');
            var icon = shareBtn.querySelector('.share-float-icon');
            label.textContent = 'Link copied';
            icon.textContent = '✓';
            setTimeout(function() {
              label.textContent = 'Share these jobs';
              icon.textContent = '↗';
            }, 2000);
          });
        }
      });
    }
  })();
</script>
