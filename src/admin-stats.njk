---
permalink: /admin/stats/index.html
eleventyExcludeFromCollections: true
---
{%- set stats = collections.jobs | jobStats(site) -%}
{#- The homepage leaves link-only roles out of everything except the roles posted total. -#}
{%- set home = collections.jobs | listed | jobStats(site) -%}
{%- set linkOnly = stats.open - home.open -%}
{%- set filled = stats.total - stats.open -%}
{%- macro visibility(r) -%}
{% if not r.open %}Filled{% elif r.unlisted %}Open, link only{% else %}Open, on homepage{% endif %}
{%- endmacro -%}
{%- set live = site.homepageStats or [] -%}
{%- set visits = traffic | trafficStats(collections.jobs) -%}
{%- macro liveTag(key) -%}
{% if key in live %}<span class="live">Live on homepage</span>{% else %}<span class="live live--off">Admin only</span>{% endif %}
{%- endmacro -%}
{%- macro share(g) -%}
<div class="grp{% if not g.count %} grp--zero{% endif %}">
  <div class="grp-head"><span>{{ g.label }}</span><b>{{ (g.count / stats.total * 100) | round }}%</b></div>
  <div class="sharebar" role="img" aria-label="{{ g.count }} of {{ stats.total }} roles: {{ g.open - g.linkOnly }} on homepage, {{ g.linkOnly }} link only, {{ g.count - g.open }} filled">
    <span style="width: {{ (g.open - g.linkOnly) / stats.total * 100 }}%"></span><span class="l" style="width: {{ g.linkOnly / stats.total * 100 }}%"></span><span class="c" style="width: {{ (g.count - g.open) / stats.total * 100 }}%"></span>
  </div>
  <small>{{ g.count }} {{ "role" if g.count == 1 else "roles" }}{% if g.count %} · {{ g.open - g.linkOnly }} on homepage · {{ g.linkOnly }} link only · {{ g.count - g.open }} filled{% endif %}</small>
</div>
{%- endmacro -%}
{%- macro axis() -%}
<div class="row axis"><span></span><div class="track">{% for t in stats.scale.ticks %}<span class="tick" style="left: {{ t.pct }}%">{{ t.value | num }}</span>{% endfor %}</div><span></span></div>
{%- endmacro -%}
{%- macro groupChart(groups) -%}
<div class="chart" style="--divs: {{ stats.scale.divisions }}">
  {% for g in groups %}{% if g.avgMin %}
  <div class="row">
    <span class="name">{{ g.label }}<small>{{ g.count }} {{ "role" if g.count == 1 else "roles" }} · typical midpoint {{ g.medianMid | num }}</small></span>
    <div class="track"><span class="bar{% if g.count < 2 %} bar--thin{% endif %}" style="left: {{ g.bar.left }}%; width: {{ g.bar.width }}%"></span></div>
    <span class="val">{{ g.avgMin | num }} – {{ g.avgMax | num }}</span>
  </div>
  {% endif %}{% endfor %}
  {{ axis() }}
</div>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Stats | {{ site.siteTitle }}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/admin/admin-bar.css" />
  <style>
    body { background: #f4f5f7; display: block; font-size: 16px; line-height: 1.5; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 40px 20px 72px; display: flex; flex-direction: column; gap: 24px; }
    .intro h1 { font-size: 34px; font-weight: 700; letter-spacing: -0.025em; line-height: 1.15; }
    .intro p { color: var(--ink-mid); max-width: 78ch; margin-top: 10px; font-size: 16px; line-height: 1.55; }
    .intro a { color: var(--accent-dark); }
    .panel { background: #fff; border: 1px solid var(--card-border); border-radius: 18px; box-shadow: var(--section-shadow); padding: 28px; display: flex; flex-direction: column; gap: 18px; }
    .panel h2 { font-size: 21px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.3; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .sub { font-size: 14px; color: var(--ink-mid); margin-top: 4px; max-width: 82ch; line-height: 1.55; }
    .live { font-size: 12px; font-weight: 500; letter-spacing: 0; padding: 3px 10px; border-radius: 999px; background: var(--badge-new-soft); color: var(--badge-new); }
    .live--off { background: var(--glow); color: var(--ink-mid); }

    .strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    .strip > div { padding: 18px; border-radius: 14px; background: linear-gradient(165deg, #f8f9fb 0%, #f2f4f6 100%); border: 1px solid rgba(0,4,2,0.05); display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
    .strip b { font-size: 28px; font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .strip b small { font-size: 14px; font-weight: 400; color: var(--ink-mid); letter-spacing: 0; }
    .strip .lbl { font-size: 14px; color: var(--ink-mid); line-height: 1.35; }
    .strip .live { margin-top: auto; }

    .legend { display: flex; gap: 16px; font-size: 14px; color: var(--ink-mid); }
    .legend span { display: inline-flex; align-items: center; gap: 6px; }
    .legend i { width: 14px; height: 8px; border-radius: 3px; background: var(--accent); }
    .legend i.c { background: #aab0b5; }

    .chart { font-variant-numeric: tabular-nums; }
    .row { display: grid; grid-template-columns: 250px 1fr 128px; align-items: center; column-gap: 14px; }
    .row .name { font-size: 14px; font-weight: 700; line-height: 1.2; }
    .row .name small { display: block; font-weight: 400; font-size: 13px; color: var(--ink-mid); margin-top: 2px; }
    .row .val { font-size: 14px; color: var(--ink-mid); text-align: right; white-space: nowrap; }
    .track { position: relative; height: 38px; border-right: 1px solid var(--border); background-image: repeating-linear-gradient(to right, var(--border) 0 1px, transparent 1px calc(100% / var(--divs))); }
    .bar { position: absolute; top: 50%; height: 12px; margin-top: -6px; border-radius: 999px; background: var(--accent); }
    .bar--closed { background: #aab0b5; }
    .bar--thin { background: none; border: 1.5px solid var(--ink-soft); }
    .median { position: absolute; top: 0; bottom: 0; width: 0; border-left: 1.5px dashed var(--ink-mid); }
    .axis .track { height: 22px; background: none; border: 0; }
    .axis .tick { position: absolute; top: 4px; transform: translateX(-50%); font-size: 12px; color: var(--ink-mid); }
    .axis--top .track { height: 20px; }
    .axis .mlabel { position: absolute; bottom: 2px; transform: translateX(-50%); font-size: 12px; color: var(--ink-mid); white-space: nowrap; background: #fff; padding: 0 4px; }

    .mix { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px 28px; }
    .mix h3 { font-family: var(--mono); font-size: 12px; font-weight: 400; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-mid); margin-bottom: 8px; }
    .grp { display: flex; flex-direction: column; gap: 5px; padding: 7px 0; font-size: 14px; }
    .grp--zero { color: var(--ink-mid); opacity: .7; }
    .grp-head { display: flex; justify-content: space-between; gap: 12px; }
    .grp-head b { font-variant-numeric: tabular-nums; }
    .grp small { font-size: 13px; color: var(--ink-mid); }
    .sharebar { display: flex; height: 10px; border-radius: 999px; overflow: hidden; background: var(--glow); }
    .sharebar span { background: var(--accent); }
    .sharebar span.l { background: color-mix(in srgb, var(--accent) 40%, #fff); }
    .sharebar span.c { background: #aab0b5; }
    .sharebar span + span.c { border-left: 2px solid #fff; }

    .tablewrap { overflow-x: auto; }
    table { border-collapse: collapse; width: 100%; min-width: 860px; font-size: 14px; font-variant-numeric: tabular-nums; }
    th { text-align: left; font-family: var(--mono); font-size: 12px; font-weight: 400; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-mid); padding: 0 12px 10px 0; border-bottom: 1px solid var(--border); white-space: nowrap; }
    td { padding: 10px 12px 10px 0; border-bottom: 1px solid var(--border); vertical-align: top; }
    tbody tr { transition: background-color .12s ease; }
    tbody tr:hover { background: #f7f8fa; }
    td.r, th.r { text-align: right; }
    td.n { white-space: nowrap; }
    td.t b { display: block; }
    td.t a { font-size: 13px; color: var(--accent-dark); word-break: break-all; }
    .copy { font: inherit; font-size: 12px; color: var(--ink); background: #fff; border: 1px solid var(--border); border-radius: 999px; padding: 1px 9px; margin-top: 4px; cursor: pointer; white-space: nowrap; transition: background-color .15s ease; }
    .copy:hover { background: var(--glow); }
    .st { display: inline-flex; align-items: center; gap: 6px; }
    .st i { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
    .st--closed i { background: #aab0b5; }
    tfoot td { border-bottom: 0; font-weight: 700; padding-top: 10px; }

    .eyebrow { font-family: var(--mono); font-size: 12px; font-weight: 400; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-mid); margin-bottom: 8px; }
    .traffic-lists { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 32px; }
    table.mini { min-width: 0; }
    table.mini a { color: var(--accent-dark); word-break: break-all; }
    .barcol { width: 50%; }
    .minibar { display: block; height: 10px; min-width: 2px; margin-top: 5px; border-radius: 999px; background: var(--accent); }
    .minibar--estimated { background: repeating-linear-gradient(135deg, rgba(50,102,255,0.6) 0 4px, rgba(50,102,255,0.25) 4px 8px); }

    @media (max-width: 720px) {
      .traffic-lists { grid-template-columns: 1fr; }
      .wrap { padding: 28px 16px 56px; gap: 18px; }
      .intro h1 { font-size: 28px; }
      .strip { grid-template-columns: 1fr 1fr; gap: 10px; }
      .strip > div { padding: 14px; }
      .strip b { font-size: 22px; white-space: normal; }
      .mix { grid-template-columns: 1fr; }
      .row { grid-template-columns: 1fr auto; padding-top: 8px; }
      .row .track { grid-column: 1 / -1; height: 26px; margin: 0 14px; }
      .panel { padding: 20px 16px; border-radius: 16px; }
    }
  </style>
</head>
<body>
  <header class="admin-bar">
    <a class="admin-brand" href="/admin/"><img src="/favicon.svg" alt="" /><span>{{ site.siteTitle }}</span><em>Admin</em></a>
    <nav class="admin-nav" aria-label="Admin">
      <a href="/admin/">Content Manager</a>
      <a href="/admin/stats/" aria-current="page">View Stats</a>
      <a href="/" target="_blank" rel="noopener">View Site <span class="ext" aria-hidden="true">↗</span></a>
      <a href="https://vercel.com/craciunpv-archs-projects/job-postings/analytics" target="_blank" rel="noopener">View Analytics <span class="ext" aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <div class="wrap">
    <header class="intro">
      <h1>Job posting stats</h1>
      {% if stats.total %}
      <p>Calculated from all {{ stats.total }} roles ever posted in the CMS since {{ stats.since }}, open and filled. Salaries are RON Net per month. B2B roles are paid in EUR per hour, gross, so they have their own B2B rates section and are not mixed into the RON figures. Link-only roles are included in everything here; on the homepage they count only in the roles posted total. The page updates whenever a role is published or edited. To choose which stats candidates see next to the job cards, open <a href="/admin/#/collections/settings/entries/site">Site Settings → Homepage Stats</a>.</p>
      {% else %}
      <p>No roles have been published yet.</p>
      {% endif %}
    </header>

    {% if stats.total %}
    <section class="panel">
      <div class="strip">
        <div><b>{{ stats.total }}</b><span class="lbl">roles posted since {{ stats.since }}: {{ home.open }} on homepage, {{ linkOnly }} link only, {{ filled }} filled</span>{{ liveTag("roles") }}</div>
        <div><b>{{ stats.salaryMin | num }} – {{ stats.salaryMax | num }}</b><span class="lbl">RON net salary range, all roles ever posted, typical midpoint {{ stats.medianMid | num }}{% if stats.b2b %}. B2B: {{ stats.b2b.min }} – {{ stats.b2b.max }} EUR / hour gross{% endif %}</span>{{ liveTag("salary") }}</div>
        <div><b>{% set sep = joiner(" · ") %}{% for w in stats.working %}{% if w.count %}{{ sep() }}{{ w.count }} <small>{{ w.label | lower }}</small>{% endif %}{% endfor %}</b><span class="lbl">working model</span>{{ liveTag("working") }}</div>
        <div><b>{{ stats.aiCount }} <small>of {{ stats.total }}</small></b><span class="lbl">work with AI or ML</span>{{ liveTag("ai") }}</div>
      </div>
      <p class="sub">The typical midpoint is the median of each role's midpoint (halfway between its min and max). A role counts as AI or ML when its Tech Stack tags include {{ stats.aiTags | join(", ") }}.{% if home.current %} The homepage shows the range for open roles listed there only, currently {{ home.current.min | num }} – {{ home.current.max | num }} RON net{% if home.b2b and home.b2b.current %} and {{ home.b2b.current.min }} – {{ home.b2b.current.max }} EUR / hour B2B{% endif %}.{% endif %}</p>
    </section>

    <section class="panel">
      <div>
        <h2>Site traffic</h2>
        {% if visits.ready %}
        <p class="sub">From Vercel Web Analytics, production site only, saved daily. Vercel's free plan keeps one month of data, so each month is stored here. All time is the sum of the stored months, or Vercel's own lifetime count when that is higher. Last updated {{ visits.updatedAt | postDate }}. Visitor numbers are shown here only; the homepage shows just the three most viewed open roles listed there.</p>
        {% else %}
        <p class="sub">Not connected yet. Once the VERCEL_ANALYTICS_TOKEN secret is added to the GitHub repository, visitor numbers are saved here every day.</p>
        {% endif %}
      </div>
      {% if visits.ready %}
      <div class="strip">
        <div><b>{{ visits.allTime.visitors | num }}</b><span class="lbl">visitors, all time</span></div>
        <div><b>{{ visits.allTime.pageviews | num }}</b><span class="lbl">page views, all time</span></div>
        <div><b>{{ visits.month.visitors | num }}</b><span class="lbl">visitors, {{ visits.monthLabel }} so far</span></div>
        <div><b>{{ visits.month.pageviews | num }}</b><span class="lbl">page views, {{ visits.monthLabel }} so far</span></div>
      </div>
      <div>
        <h3 class="eyebrow">Month by month</h3>
        {% if visits.hasEstimates %}<p class="sub" style="margin: -4px 0 10px">Vercel could not break down anything older than 31 days, so the months marked estimated are a manual split of the measured total for that period: June and July equal, August lowest. Edit them in src/_data/traffic.json.</p>{% endif %}
        <table class="mini">
          <thead><tr><th>Month</th><th class="barcol">Visitors</th><th class="r"></th><th class="r">Page views</th></tr></thead>
          <tbody>
            {% for m in visits.months %}
            <tr><td class="n">{{ m.label }}{% if m.current %} (so far){% endif %}{% if m.note %} ({{ m.note }}){% endif %}{% if m.estimated %} (estimated){% endif %}</td><td class="barcol"><span class="minibar{% if m.estimated %} minibar--estimated{% endif %}" style="width: {{ m.pct }}%"></span></td><td class="r">{% if m.estimated %}~{% endif %}{{ m.visitors | num }}</td><td class="r">{% if m.estimated %}~{% endif %}{{ m.pageviews | num }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% if visits.topPages.length or visits.topReferrers.length %}
      <div class="traffic-lists">
        <div>
          <h3 class="eyebrow">Most viewed pages, last 30 days {{ liveTag("topRoles") }}</h3>
          <table class="mini">
            <thead><tr><th>Page</th><th class="r">Visitors</th><th class="r">Page views</th></tr></thead>
            <tbody>{% for row in visits.topPages.slice(0, 10) %}<tr><td><a href="{{ row.label }}" target="_blank" rel="noopener">{{ row.label }}</a></td><td class="r">{{ row.visitors | num }}</td><td class="r">{{ row.pageviews | num }}</td></tr>{% endfor %}</tbody>
          </table>
        </div>
        <div>
          <h3 class="eyebrow">Where visitors came from, last 30 days</h3>
          <table class="mini">
            <thead><tr><th>Source</th><th class="r">Visitors</th><th class="r">Page views</th></tr></thead>
            <tbody>{% for row in visits.topReferrers %}<tr><td>{{ row.label }}</td><td class="r">{{ row.visitors | num }}</td><td class="r">{{ row.pageviews | num }}</td></tr>{% endfor %}</tbody>
          </table>
        </div>
      </div>
      {% endif %}
      {% endif %}
    </section>

    <section class="panel">
      <div>
        <h2>What our roles pay</h2>
        <p class="sub">RON net monthly salary range for every employee role ever posted. The dashed line is the typical midpoint.{% if stats.b2b %} B2B roles are in the next section.{% endif %}</p>
      </div>
      <p class="legend"><span><i></i>Open</span><span><i class="c"></i>Filled</span></p>
      <div class="chart" style="--divs: {{ stats.scale.divisions }}">
        <div class="row axis axis--top"><span></span><div class="track"><span class="mlabel" style="left: {{ stats.scale.medianPct }}%">typical midpoint {{ stats.medianMid | num }}</span></div><span></span></div>
        {% for r in stats.roles %}
        <div class="row">
          <span class="name">{{ r.title }}<small>{{ visibility(r) }} · {{ r.seniority }} · {{ r.workingType }}</small></span>
          <div class="track"><span class="median" style="left: {{ stats.scale.medianPct }}%"></span><span class="bar{% if not r.open %} bar--closed{% endif %}" style="left: {{ r.bar.left }}%; width: {{ r.bar.width }}%" title="{{ r.title }}: {{ r.min | num }} – {{ r.max | num }}"></span></div>
          <span class="val">{{ r.min | num }} – {{ r.max | num }}</span>
        </div>
        {% endfor %}
        {{ axis() }}
      </div>
    </section>

    {% if stats.b2b %}
    <section class="panel">
      <div>
        <h2>B2B hourly rates {{ liveTag("salary") }}</h2>
        <p class="sub">Gross EUR per hour for every B2B role ever posted, {{ stats.b2b.count }} {{ "role" if stats.b2b.count == 1 else "roles" }}. Range {{ stats.b2b.min }} – {{ stats.b2b.max }}, typical midpoint {{ stats.b2b.medianMid | num }}. The dashed line is the typical midpoint.</p>
      </div>
      <p class="legend"><span><i></i>Open</span><span><i class="c"></i>Filled</span></p>
      <div class="chart" style="--divs: {{ stats.b2b.scale.divisions }}">
        <div class="row axis axis--top"><span></span><div class="track"><span class="mlabel" style="left: {{ stats.b2b.scale.medianPct }}%">typical midpoint {{ stats.b2b.medianMid | num }}</span></div><span></span></div>
        {% for r in stats.b2b.roles %}
        <div class="row">
          <span class="name">{{ r.title }}<small>{{ visibility(r) }} · {{ r.seniority }} · {{ r.workingType }}</small></span>
          <div class="track"><span class="median" style="left: {{ stats.b2b.scale.medianPct }}%"></span><span class="bar{% if not r.open %} bar--closed{% endif %}" style="left: {{ r.bar.left }}%; width: {{ r.bar.width }}%" title="{{ r.title }}: {{ r.rateMin }} – {{ r.rateMax }} EUR / hour"></span></div>
          <span class="val">{{ r.rateMin }} – {{ r.rateMax }} EUR/h</span>
        </div>
        {% endfor %}
        <div class="row axis"><span></span><div class="track">{% for t in stats.b2b.scale.ticks %}<span class="tick" style="left: {{ t.pct }}%">{{ t.value }}</span>{% endfor %}</div><span></span></div>
      </div>
    </section>
    {% endif %}

    <section class="panel">
      <div>
        <h2>Salary by seniority {{ liveTag("seniority") }}</h2>
        <p class="sub">Average RON net min and max per seniority level set in the CMS; B2B roles are not included. A role open to several levels has one range covering all of them.</p>
      </div>
      {{ groupChart(stats.seniority) }}
    </section>

    <section class="panel">
      <div>
        <h2>Salary by role type {{ liveTag("roleType") }}</h2>
        <p class="sub">Average RON net min and max per Role Type set in the CMS; B2B roles are not included. A type with a single role is drawn as an outline.{% if stats.untypedCount %} {{ stats.untypedCount }} {{ "role has" if stats.untypedCount == 1 else "roles have" }} no Role Type yet.{% endif %}</p>
      </div>
      {{ groupChart(stats.roleTypes) }}
    </section>

    <section class="panel">
      <div>
        <h2>What kind of roles these are</h2>
        <p class="sub">Share of all {{ stats.total }} roles. Dark blue is open on the homepage, light blue is open by link only, grey is filled.</p>
      </div>
      <div class="mix">
        <div><h3>Role type</h3>{% for g in stats.roleTypes %}{{ share(g) }}{% endfor %}</div>
        <div><h3>Seniority</h3>{% for g in stats.seniority %}{{ share(g) }}{% endfor %}</div>
        <div><h3>Working model</h3>{% for g in stats.working %}{{ share(g) }}{% endfor %}</div>
      </div>
    </section>

    <section class="panel">
      <div>
        <h2>All {{ stats.total }} job postings</h2>
        <p class="sub">Newest first, with each role's public link.</p>
      </div>
      <div class="tablewrap">
        <table>
          <thead><tr><th>Role and URL</th><th>Visibility</th><th class="r">Min</th><th class="r">Max</th><th class="r">Midpoint</th><th>Seniority</th><th>Working</th><th>City</th><th>Role type</th><th>Tech stack</th><th>Posted</th></tr></thead>
          <tbody>
            {% for r in stats.rolesByDate %}
            <tr>
              <td class="t"><b>{{ r.title }}</b><a href="{{ r.url }}" target="_blank" rel="noopener">{{ site.siteUrl | replace("https://", "") }}{{ r.url }}</a> <button class="copy" type="button" data-url="{{ site.siteUrl }}{{ r.url }}">Copy</button></td>
              <td class="n"><span class="st{% if not r.open %} st--closed{% endif %}"><i></i>{{ visibility(r) }}</span></td>
              {% if r.rateMid %}
              <td class="r n">{{ r.rateMin }} EUR/h</td>
              <td class="r n">{{ r.rateMax }} EUR/h</td>
              <td class="r n">{{ r.rateMid | num }} EUR/h</td>
              {% else %}
              <td class="r">{{ r.min | num if r.min else "–" }}</td>
              <td class="r">{{ r.max | num if r.max else "–" }}</td>
              <td class="r">{{ r.mid | num if r.mid else "–" }}</td>
              {% endif %}
              <td class="n">{{ r.seniority }}</td>
              <td>{{ r.workingType }}</td>
              <td>{{ r.city }}</td>
              <td>{{ r.roleType }}</td>
              <td>{{ r.techStack | join(", ") }}</td>
              <td class="n">{{ r.date | postDate }}</td>
            </tr>
            {% endfor %}
          </tbody>
          <tfoot><tr><td>{{ stats.total }} roles</td><td>{{ home.open }} on homepage, {{ linkOnly }} link only, {{ filled }} filled</td><td class="r">{{ stats.salaryMin | num }}</td><td class="r">{{ stats.salaryMax | num }}</td><td class="r">{{ stats.medianMid | num }}</td><td colspan="6">lowest min, highest max, median midpoint, RON net roles only</td></tr></tfoot>
        </table>
      </div>
    </section>
    {% endif %}
  </div>
  <script>
    document.querySelectorAll('.copy').forEach(function (btn) {
      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(btn.dataset.url).then(function () {
          btn.textContent = 'Copied ✓';
          setTimeout(function () { btn.textContent = 'Copy'; }, 2000);
        });
      });
    });
  </script>
</body>
</html>
